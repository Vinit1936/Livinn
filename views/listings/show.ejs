<% layout("/layouts/boilerplate.ejs") %>



  <div class="container d-flex justify-content-center mt-3 mb-3">
    <div class="col-md-7">

      <!-- Title -->
      <h3 style="
          padding-bottom: 0.75rem;
          font-size: 1.35rem;
          color: #ff385c ;
        ">
        <%= listing.title %>
      </h3>

      <!-- Card -->
      <div class="card show-card listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img mb-2" alt="listing_image" />
        <div class="card-body">
          <p class="text-muted mb-3">
            <%= listing.description %>
          </p>
          <p class="mb-1"><b>Price:</b> &#8377;<%= listing.price.toLocaleString("en-IN") %>
          </p>
          <p class="mb-1"><b>Location:</b>
            <%= listing.location %>
          </p>
          <p class="mb-1"><b>Country:</b>
            <%= listing.country %>
          </p>
          <p class="mb-1"><b>Owner:</b>
            <i>
              <%= listing.owner.username %>
            </i>
          </p>
        </div>
      </div>

      <!-- Buttons -->
      <% if (currentUser && currentUser._id.toString()===listing.owner._id.toString()) { %>
        <div class="btns">
          <a class="btn btn-dark done-btn" href="/listings/<%= listing._id %>/edit">Edit</a>
          <form method="post" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark">Delete</button>
          </form>
        </div>
        <% } %>

          <!-- reviews -->
          <hr>
          <% if(currentUser){ %>
            <div class="col-md-12 mb-3">

              <h4>Leave a Review!</h4>
              <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                <!-- <div class="mb-3 mt-3">
                  <label for="review" class="form-label">Rating</label>
                  <input class="form-range" type="range" min="1" max="5" id="rating" name="review[rating]">
                </div> -->

                <div class="mb-3 mt-3">
                  <i><label for="review" class="form-label ms-1">Rating</label></i>
                  <!-- starablity -->
                  <fieldset class="starability-basic">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                      aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                  <!-- -- -->
                </div>
                <div class="mb-3 mt-3">
                  <label for="comment" class="form-label">Comments</label>
                  <textarea rows="5" required cols="2" name="review[comment]" class="form-control"
                    id="comment"></textarea>
                  <div class="invalid-feedback">Comment can not be empty!</div>
                </div>

                <button class="btn btn-outline-dark">Submit</button>
              </form>
            </div>
            <hr>
            <% } %>
              <!-- show reviews -->
              <!-- show reviews -->
              <% if (listing.reviews && listing.reviews.length> 0) { %>
                <p><b>All Reviews:</b></p>
                <div class="row">
                  <% for (let review of listing.reviews) { %>
                    <div class="card col-5 ms-4 me-3 mb-3 show-review-card">
                      <div class="card-body">
                        <p style="font-size: medium;" class="card-title"><b><i>@<%= review.author.username %></i></b>
                        </p>
                        <p class="card-text">
                          <%= review.comment %>
                        </p>
                        <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                      </div>
                      <form method="post"
                        action="/listings/<%= listing._id %>/reviews/<%= review._id %>/?_method=DELETE">
                        <% // if (currentUser && currentUser._id.toString()===review.author._id.toString()) { %>
                          <button class="btn btn-sm btn-outline-dark mb-3 ms-3">Delete</button>
                          <% // } %>
                      </form>
                    </div>
                    <% } %>
                </div>
                <% } else { %>
                  <p class="text-muted">No reviews yet. Be the first to leave one!</p>
                  <% } %>
                  <hr>
                    <div>
                      <h6>Where you'll be</h6>
                      <div id="map"></div>

                    </div>

    </div>
  </div>
  </div>
  
<% 
  const coords = listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : [0, 0];
%>
<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const coordinates = <%- JSON.stringify(coords) %>;
</script>
<script src="/js/map.js"></script>
