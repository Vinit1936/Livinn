    <!-- <form action="/listings/new" method="get"><button>Create new Listing</button></form> -->
    <div id="listing-index">
      <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 mt-1">
      <% for (listing of allListings){%>
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card col listing-card" style="width: 18rem">
            <img src="<%=listing.image.url%>" class="card-img-top index-img" alt="..." />
            <div class="card-img-overlay"></div>
            <div class="card-body">
              <p class="card-text">
                <b>
                  <%=listing.title%>
                </b> <br />
                &#8377;<%=listing.price.toLocaleString("en-IN")%>
              </p>
            </div>
          </div>
        </a>
        <% }%>
      </div>
    </div>
  </body>