<%layout("/layouts/boilerplate.ejs")%>

  <body>
    <link rel="stylesheet" href="/css/styles.css" />
<style>

</style>

<div id="filters">
  <a class="filter <%= !currentCategory ? 'active' : '' %>" href="/listings">
    <i class="fa-solid fa-border-all"></i> All
  </a>
  <a class="filter <%= currentCategory==='Beach' ? 'active' : '' %>" href="/listings?category=Beach">
    <i class="fa-solid fa-umbrella-beach"></i> Beach
  </a>
  <a class="filter <%= currentCategory==='City' ? 'active' : '' %>" href="/listings?category=City">
    <i class="fa-solid fa-city"></i> City
  </a>
  <a class="filter <%= currentCategory==='Mountain' ? 'active' : '' %>" href="/listings?category=Mountain">
    <i class="fa-solid fa-mountain"></i> Mountain
  </a>
  <a class="filter <%= currentCategory==='Lake' ? 'active' : '' %>" href="/listings?category=Lake">
    <i class="fa-solid fa-water"></i> Lake
  </a>
  <a class="filter <%= currentCategory==='Ski' ? 'active' : '' %>" href="/listings?category=Ski">
    <i class="fa-solid fa-person-skiing"></i> Ski
  </a>
  <a class="filter <%= currentCategory==='Desert' ? 'active' : '' %>" href="/listings?category=Desert">
    <i class="fa-solid fa-sun"></i> Desert
  </a>
  <a class="filter <%= currentCategory==='Cabin' ? 'active' : '' %>" href="/listings?category=Cabin">
    <i class="fa-solid fa-house-chimney"></i> Cabin
  </a>
  <a class="filter <%= currentCategory==='Villa' ? 'active' : '' %>" href="/listings?category=Villa">
    <i class="fa-solid fa-crown"></i> Villa
  </a>
</div>




